{
  "enabled": true,
  "name": "Run parser tests on save",
  "description": "Whenever the parser or an app config changes, run the test suite and fix any failure before continuing.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["skeleton/parser.js", "app-*/config.js", "skeleton/parser.test.mjs"] },
  "then": { "type": "askAgent", "prompt": "Run `npm test`. If any assertion fails, explain which spoken phrase broke and fix the parser without special-casing a single app. Keep the 1..999,999 round-trip property test green." }
}
